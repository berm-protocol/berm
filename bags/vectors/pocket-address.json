{
  "name": "berm/pocket/npub-to-evm-address",
  "version": 1,
  "frozen": true,
  "note": "A Nostr key is a secp256k1 keypair, so every npub has one canonical EVM address. BIP-340 x-only pubkeys are the EVEN-y point, so a secret key whose point has ODD y must be negated (n - d) to obtain the key that actually controls the derived address. spendingKeyIsNegated marks those cases. Any implementation that ignores it produces a plausible address that nobody can spend from.",
  "derivation": [
    "xonly = x-coordinate of d*G, 32 bytes",
    "point = 0x02 || xonly            (BIP-340: even y)",
    "addr  = keccak256(x || y)[12:]   (uncompressed point, 04 prefix removed)",
    "spendingKey = d if y(d*G) is even else (n - d)"
  ],
  "coverage": {
    "total": 10,
    "evenY": 8,
    "oddY": 2
  },
