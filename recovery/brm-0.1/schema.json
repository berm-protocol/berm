{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://berm-protocol.github.io/berm/recovery/brm-0.1/schema.json",
  "title": "Berm Recovery Module 0.1 structural profile",
  "$comment": "Register brm-js-date as Number.isFinite(Date.parse(value)) for string values, with format assertions enabled. Shape validation is not decryption, NIP-49 validity, npub checksum validation or public metadata/root equality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "identity",
    "recovery",
    "derived"
  ],
  "properties": {
    "schema": {
      "const": "berm.recovery_module/0.1"
    },
    "created_at": {
      "type": "string",
      "format": "brm-js-date"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npub",
        "pubkey_hex"
      ],
      "properties": {
        "npub": {
          "type": "string",
          "pattern": "^npub1"
        },
        "pubkey_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "ncryptsec"
      ],
      "properties": {
        "format": {
          "const": "nip49"
        },
        "ncryptsec": {
          "type": "string",
          "pattern": "^ncryptsec1[023456789acdefghjklmnpqrstuvwxyz]+$"
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evm"
      ],
      "properties": {
        "evm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            }
          }
        }
      }
    }
  }
}
